<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TintaESReader</AssemblyName>
    <RootNamespace>TintaES.Reader</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- El Reader es la aplicación madre en modo de solo lectura. No vuelve a compilar un visor
         paralelo: referencia TintaES.Wpf y arranca su MainWindow real. -->
    <ProjectReference Include="..\TintaES.Wpf\TintaES.Wpf.csproj" />

    <!-- Implementación histórica del visor independiente. Se conserva en Git únicamente como
         referencia mientras se valida la transición, pero no forma parte del ejecutable. -->
    <Compile Remove="Reader*.cs" />
  </ItemGroup>
</Project>
