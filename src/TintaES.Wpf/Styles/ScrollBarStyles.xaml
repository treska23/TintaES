<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Barra común para el editor y el lector: discreta en reposo y visible al interactuar. -->
    <ControlTemplate x:Key="ScrollBarPageButtonTemplate"
                     TargetType="{x:Type RepeatButton}">
        <Border Background="Transparent" />
    </ControlTemplate>

    <ControlTemplate x:Key="VerticalScrollBarThumbTemplate"
                     TargetType="{x:Type Thumb}">
        <Grid Background="Transparent">
            <Border x:Name="ThumbSurface"
                    Margin="3,2"
                    Background="{TemplateBinding Background}"
                    CornerRadius="3"
                    SnapsToDevicePixels="True" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ThumbSurface"
                        Property="Background"
                        Value="{DynamicResource MutedBrush}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ThumbSurface"
                        Property="Background"
                        Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ThumbSurface" Property="Opacity" Value="0.32" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarThumbTemplate"
                     TargetType="{x:Type Thumb}">
        <Grid Background="Transparent">
            <Border x:Name="ThumbSurface"
                    Margin="2,3"
                    Background="{TemplateBinding Background}"
                    CornerRadius="3"
                    SnapsToDevicePixels="True" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ThumbSurface"
                        Property="Background"
                        Value="{DynamicResource MutedBrush}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ThumbSurface"
                        Property="Background"
                        Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ThumbSurface" Property="Opacity" Value="0.32" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="VerticalScrollBarTemplate"
                     TargetType="{x:Type ScrollBar}">
        <Border Background="{TemplateBinding Background}"
                CornerRadius="6"
                SnapsToDevicePixels="True">
            <Track x:Name="PART_Track"
                   Margin="1"
                   IsDirectionReversed="True"
                   Maximum="{TemplateBinding Maximum}"
                   Minimum="{TemplateBinding Minimum}"
                   Orientation="Vertical"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                  Focusable="False"
                                  IsTabStop="False"
                                  Template="{StaticResource ScrollBarPageButtonTemplate}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinHeight="28"
                           Background="{TemplateBinding Foreground}"
                           Template="{StaticResource VerticalScrollBarThumbTemplate}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                  Focusable="False"
                                  IsTabStop="False"
                                  Template="{StaticResource ScrollBarPageButtonTemplate}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate"
                     TargetType="{x:Type ScrollBar}">
        <Border Background="{TemplateBinding Background}"
                CornerRadius="6"
                SnapsToDevicePixels="True">
            <Track x:Name="PART_Track"
                   Margin="1"
                   IsDirectionReversed="False"
                   Maximum="{TemplateBinding Maximum}"
                   Minimum="{TemplateBinding Minimum}"
                   Orientation="Horizontal"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                  Focusable="False"
                                  IsTabStop="False"
                                  Template="{StaticResource ScrollBarPageButtonTemplate}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinWidth="28"
                           Background="{TemplateBinding Foreground}"
                           Template="{StaticResource HorizontalScrollBarThumbTemplate}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                  Focusable="False"
                                  IsTabStop="False"
                                  Template="{StaticResource ScrollBarPageButtonTemplate}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- El estilo implícito alcanza también las barras internas de ListBox, TextBox y ComboBox. -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource LineBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
