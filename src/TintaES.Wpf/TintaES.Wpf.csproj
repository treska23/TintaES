<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TintaES</AssemblyName>
    <RootNamespace>TintaES.Wpf</RootNamespace>
    <ApplicationIcon>Resources\TintaES.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TintaES.Core\TintaES.Core.csproj" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <Resource Include="Resources\TintaES.ico" />
    <Resource Include="Resources\Fonts\klee_one_semibold_es.ttf"
              Condition="Exists('Resources\Fonts\klee_one_semibold_es.ttf')" />
    <Resource Include="..\..\engine\manga-image-translator\fonts\comic shanns 2.ttf"
              Link="Resources\Fonts\comic_shanns_2.ttf"
              Condition="Exists('..\..\engine\manga-image-translator\fonts\comic shanns 2.ttf')" />
    <Resource Include="..\..\engine\manga-image-translator\fonts\anime_ace_3.ttf"
              Link="Resources\Fonts\anime_ace_3.ttf"
              Condition="Exists('..\..\engine\manga-image-translator\fonts\anime_ace_3.ttf')" />
  </ItemGroup>
</Project>
